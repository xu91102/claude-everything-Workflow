{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/runtime/run-with-flags.js\" post:edit:console-log \"$HOME/.claude/hooks/check-console-log.js\" standard,strict",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/runtime/run-with-flags.js\" post:edit:code-size \"$HOME/.claude/hooks/check-code-size.js\" standard,strict",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/runtime/run-with-flags.js\" pre:bash:commit-quality \"$HOME/.claude/hooks/commit-quality.js\" standard,strict",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
