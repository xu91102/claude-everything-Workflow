{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/runtime/run-with-flags.js\" post:edit:console-log \"$HOME/.claude/hooks/check-console-log.js\" standard,strict",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/runtime/run-with-flags.js\" post:edit:code-size \"$HOME/.claude/hooks/check-code-size.js\" standard,strict",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/runtime/run-with-flags.js\" post:observe \"$HOME/.claude/skills/continuous-learning-v2/hooks/observe-v2.js\" strict post",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
