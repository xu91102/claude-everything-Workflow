  "discovered_in": "gpt-base-r1, then gpt-cew-r1",
  "protocol": "Same eight queries for parent, upstream reference, and every completed numeric_range trial; no model rerun and no checkout modification",
  "python_program": "import json, sys\nfrom decimal import Decimal, localcontext\nfrom datetime import datetime, timedelta\ndata = json.load(sys.stdin)\nsys.path.insert(0, data[\"support\"])\nnamespace = {\"__name__\": \"more_itertools.more\", \"__package__\": \"more_itertools\", \"__file__\": \"<frozen-source>\"}\nexec(compile(data[\"source\"], \"<frozen-source>\", \"exec\"), namespace)\ncls = namespace[\"numeric_range\"]\nrows = []\nwith localcontext() as context:\n    context.prec = 2\n    cases = [(\"finite_float_huge_range\", (0.0, 1e308, 1e-308)), (\"decimal_precision_2\", (Decimal(0), Decimal(10), Decimal(\"0.1\")))]\n    for name, args in cases:\n        for operation in (\"contains\", \"index\"):\n            try:\n                instance = cls(*args)\n                value = (args[0] in instance) if operation == \"contains\" else instance.index(args[0])\n                correct = (value is True) if operation == \"contains\" else (type(value) is int and value == 0)\n                rows.append({\"case\": name, \"operation\": operation, \"passed\": correct, \"value\": repr(value)})\n            except Exception as error:\n                rows.append({\"case\": name, \"operation\": operation, \"passed\": False, \"exception\": type(error).__name__, \"message\": str(error)})\ndate_cases = [(\"datetime_upper_bound\", (datetime.max - timedelta(days=1), datetime.max, timedelta(days=2))), (\"datetime_lower_bound\", (datetime.min + timedelta(days=1), datetime.min, -timedelta(days=2)))]\nfor name, args in date_cases:\n    for operation in (\"len\", \"first\"):\n        try:\n            instance = cls(*args)\n            value = len(instance) if operation == \"len\" else instance[0]\n            correct = value == (1 if operation == \"len\" else args[0])\n            rows.append({\"case\": name, \"operation\": operation, \"passed\": correct, \"value\": repr(value)})\n        except Exception as error:\n            rows.append({\"case\": name, \"operation\": operation, \"passed\": False, \"exception\": type(error).__name__, \"message\": str(error)})\nprint(json.dumps(rows))\n",
